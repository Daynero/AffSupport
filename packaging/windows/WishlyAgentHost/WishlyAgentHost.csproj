<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Wishly.AgentHost</RootNamespace>
    <AssemblyName>WishlyAgentHost</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Allows building the Windows host from macOS/Linux CI and dev machines. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- The host only talks to 127.0.0.1 and renders fixed English strings. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Soty.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- HostConfig.template.cs contains __TOKEN__ placeholders and is not valid C#.
         scripts/render-launcher.mjs renders it to HostConfig.cs (gitignored). -->
    <Compile Remove="HostConfig.template.cs" />
    <None Include="HostConfig.template.cs" />
  </ItemGroup>

  <Target Name="EnsureHostConfigRendered" BeforeTargets="BeforeCompile">
    <Error
      Condition="!Exists('$(MSBuildProjectDirectory)/HostConfig.cs')"
      Text="HostConfig.cs is missing. Render it first: node scripts/render-launcher.mjs packaging/windows/WishlyAgentHost/HostConfig.template.cs packaging/windows/WishlyAgentHost/HostConfig.cs TOKEN=value ... (see packaging/windows/README.md)." />
  </Target>

</Project>
