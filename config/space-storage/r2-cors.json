{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://next.soty.pp.ua",
          "https://soty.pp.ua",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": [
          "content-type",
          "content-md5",
          "content-length",
          "x-amz-content-sha256",
          "x-amz-date",
          "authorization",
          "range"
        ]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
