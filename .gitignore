node_modules/
dist/
build/
*.tsbuildinfo
*.log
.DS_Store
Thumbs.db
*.tmp
*.swp
.vscode/
# Anchored deliberately. An unanchored `release/` matches a directory of that
# name at ANY depth, which silently excluded scripts/lib/release/ (the entire
# release runner) and packaging/release/ResourceProbe.swift from the repository
# while their tests were committed — a suite that cannot run on a fresh clone,
# and an implementation that existed on exactly one disk.
/release/
.env
.env.*
!.env.example
!.env.beta.example
!apps/web/.env.production
coverage/
apps/soty-review/review-output/
.idea/
supabase/.temp/
supabase/.branches/
supabase/functions/.env.local
packaging/icon-source/

# Whisper models & bundled binaries (large; fetched/built locally)
apps/agent/runtime/

# Local signing keys — never commit private keys.
config/keys/

# Written by scripts/verify-all.mjs on every run; the result is machine-read, not committed.
verification-result.json
verification-suite.json
verification-progress.log
