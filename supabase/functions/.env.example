# Fail closed unless a developer explicitly opts into an isolated testing flow.
DRIVE_OAUTH_MODE=disabled

# Canonical public origins. Never place credentials or refresh tokens here.
WISHLY_SITE_URL=http://127.0.0.1:5173
PRODUCTION_SITE_ORIGIN=https://soty.pp.ua

# Google OAuth web application configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/drive-oauth-callback

# Invitation delivery.
#
# BETA: both MUST stay empty. Invitations do not travel through the local mail
# catcher — team-invitations/email.ts posts straight to the delivery API — so a
# credential here would send real invitations to real people from a test
# environment. With neither set, the function returns the invitation link for
# local display instead of sending it. The beta doctor fails with
# BETA_DELIVERY_PROVIDER_FORBIDDEN if either is present.
RESEND_API_KEY=
INVITE_EMAIL_FROM=

# Temporary membership pilot only. Defaults to disabled; testing adds only an existing
# confirmed Soty account after caller + database permission checks.
TEAM_DIRECT_ADD_MODE=disabled

# Named secret used only by the bounded catalog worker.
CATALOG_SYNC_SECRET=

# Non-secret Creative Library bounds. Heavy work still requires an explicit caller action.
LIBRARY_JOB_LEASE_SECONDS=90
LIBRARY_ATTACH_BATCH_MAX=100

# BETA: copy this file to .env.local and set
#   AGENT_TOKEN_PRIVATE_KEY  = contents of config/keys/beta-agent-entitlement.private.pem
#                              (generated by `node scripts/generate-signing-keys.mjs --beta`)
#   WISHLY_SITE_URL          = http://127.0.0.1:5175
#   DRIVE_OAUTH_MODE         = disabled
# The beta entitlement keypair is deliberately separate from production, so a
# production-issued token is cryptographically invalid in beta and vice versa.
#
# Local development only: copy this file to .env.local and set
# DRIVE_OAUTH_MODE=testing. Production must remain disabled until provider
# verification is complete, then use the explicit verified mode.
