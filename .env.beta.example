# Beta staging environment profile — copy to `.env.beta` and fill in local values.
#
# `.env.beta` is git-ignored by the existing `.env.*` rule; this template is the
# only tracked half and MUST contain placeholders only. Every value below is a
# loopback address or a locally generated key: the beta environment must be
# fully usable without registering for any third-party service, and it refuses
# to start if a production endpoint or credential is present.
#
# One-time setup:
#   cp .env.beta.example .env.beta
#   node scripts/generate-signing-keys.mjs --beta
#   npm run beta:doctor

# --- Environment identity -------------------------------------------------
# Must be exactly `beta`. An absent or unknown value means `production`, so the
# beta scripts assert this explicitly rather than relying on the default.
VITE_APP_ENVIRONMENT=beta
SOTY_ENVIRONMENT=beta

# --- Local Supabase stack (`npx supabase start` prints these) --------------
# Loopback only. A non-loopback value fails with BETA_PRODUCTION_ENDPOINT.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=http://127.0.0.1:5175

# --- Beta agent -----------------------------------------------------------
VITE_AGENT_URL=http://127.0.0.1:43140
AGENT_PORT=43140
PUBLIC_SITE_ORIGIN=http://127.0.0.1:43140
DEV_SITE_ORIGIN=http://127.0.0.1:5175
AGENT_SUPPORT_DIRECTORY_NAME=Soty Beta

# Public half of the beta entitlement keypair, printed by
# `node scripts/generate-signing-keys.mjs --beta`. It MUST differ from the
# production key so a production token is cryptographically invalid here and a
# beta token is invalid in production.
AGENT_ENTITLEMENT_PUBLIC_KEY=

# --- Behaviour switches ---------------------------------------------------
# Analytics is additionally suppressed in code when the environment is `beta`,
# so this flag is a declaration of intent, not the only thing standing between
# beta activity and the production analytics store.
VITE_ANALYTICS_ENABLED=false

# Beta authenticates for real against the local stack. `true` would substitute a
# hardcoded user and bypass Supabase entirely — that is what `Soty Dev` does,
# and it would make beta useless for verifying sign-in, sessions, profiles, or
# account status. A `true` value fails with BETA_LOCAL_AUTH_FORBIDDEN.
VITE_LOCAL_DEV_AUTH=false

VITE_TEAM_DIRECT_ADD_MODE=disabled
# Team storage chooser (feature 011): a Picker API key and project number from
# the same test Cloud project as the opt-in OAuth test client in docs/BETA.md.
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PROJECT_NUMBER=

# --- Message delivery -----------------------------------------------------
# MUST stay empty. Team invitations do not travel through the local mail
# catcher: supabase/functions/team-invitations/email.ts posts directly to a
# third-party delivery API, so a credential here would send real invitations to
# real people. With no credential configured the invitation flow returns the
# link for local display instead of sending it.
# A set value fails with BETA_DELIVERY_PROVIDER_FORBIDDEN.
RESEND_API_KEY=
INVITE_EMAIL_FROM=
